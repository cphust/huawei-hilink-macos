<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.hilink-switch</string>
    <key>ProgramArguments</key><array><string>--launchd</string></array>
    <key>RunAtLoad</key><true/>
    <key>LaunchEvents</key>
    <dict>
        <key>com.apple.iokit.matching</key>
        <dict>
            <key>huawei-1f01</key>
            <dict>
                <key>IOProviderClass</key><string>IOUSBHostDevice</string>
                <key>idVendor</key><integer>4817</integer>
                <key>idProduct</key><integer>7937</integer>
                <key>IOMatchLaunchStream</key><true/>
            </dict>
        </dict>
    </dict>
    <key>ProcessType</key><string>Background</string>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>Umask</key><integer>63</integer>
</dict>
</plist>
